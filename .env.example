# 이 파일은 실제 비밀번호가 없는 "견본"입니다. Git에 올라갑니다.
# 실제로 쓰는 비밀 값은 .env 파일에 넣으세요 (.env는 .gitignore에 등록되어 Git에 올라가지 않습니다).
# 사용법: 이 파일을 .env로 복사한 뒤, 아래 값들을 실제 값으로 채우세요.
#   cp .env.example .env   (Windows PowerShell: copy .env.example .env)

# ---------------- 데이터베이스 (PostgreSQL) ----------------
DB_NAME=dokjon_db
DB_USER=postgres
DB_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=5432

# ---------------- Django 운영 설정 (14단계: AWS 배포 서버에서만 채우면 됩니다) ----------------
# 로컬 개발 PC에서는 아래 4개를 비워두거나 이 파일에서 지워도 됩니다
# (config/settings.py가 알아서 개발용 기본값으로 동작합니다).

# 운영 서버 전용 SECRET_KEY. 아래 명령으로 새로 하나 만들어서 넣으세요:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# 운영 서버에서는 반드시 False로 설정하세요.
DEBUG=False

# 쉼표로 구분해서 여러 개 등록 가능합니다.
ALLOWED_HOSTS=dokjon.com,www.dokjon.com

CSRF_TRUSTED_ORIGINS=https://dokjon.com,https://www.dokjon.com

# ---------------- 문의 메일 발송 (광고/제휴 문의, 고객센터) ----------------
# 비워두면 메일은 실제로 안 나가고 runserver 창에만 출력됩니다(문의 내용은 DB에 항상 저장됨).
# 네이버 메일: 환경설정 > POP3/IMAP 설정 > IMAP/SMTP 사용 켜기. 2단계 인증 사용 시 "애플리케이션 비밀번호" 사용.
CONTACT_EMAIL=dlrjsgmli@naver.com
EMAIL_HOST=smtp.naver.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ---------------- SEO (검색엔진) ----------------
# 도메인 연결 후 대표 주소 (canonical·sitemap에 사용). 비워두면 접속 주소 그대로 사용
SITE_URL=https://www.dokjon.com
# 구글 서치 콘솔 / 네이버 서치어드바이저의 "HTML 태그" 소유확인 코드 (content 값만)
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=
